          }
        },
        "failure_data": {
          "$ref": "#/$defs/failure_data"
        },
        "payment_pending": {
          "type": "boolean"
        }
      }
    },
    "execution_outcome": {
      "type": "object",
      "required": [
        "source_channel_id",
        "dest_channel_id",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "source_channel_id": {
          "type": "string",
          "minLength": 1
        },
        "dest_channel_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "$ref": "#/$defs/execution_result"
        }
      }
    },
    "final_pair": {
      "allOf": [
        {
          "$ref": "#/$defs/generated_pair"
        },
        {
          "type": "object",
          "properties": {
            "score_decomposition": {
              "$ref": "#/$defs/ev_score_decomposition"
            }
          }
        }
      ]

        "source_utilization": {
          "$ref": "#/$defs/wire_number"
        },
        "source_utilization_discount": {
          "$ref": "#/$defs/wire_number"
        },
        "activity_penalty_sats": {
          "$ref": "#/$defs/wire_number"
        },
        "inputs": {
          "$ref": "#/$defs/ev_gate_inputs"
        }
      },
      "propertyNames": {
        "not": {
          "enum": [
            "__f__",
            "__f64__"
          ]
        }
      },
      "additionalProperties": true
    }
  },

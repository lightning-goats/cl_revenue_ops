{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightning-goats/cl_revenue_ops/schemas/ledger_projection.v0.schema.json",
  "title": "Ledger projection v0 (draft, Phase F)",
  "description": "The state derived by replaying the append-only econ ledger (EconLedger.replay): outstanding reservations, cumulative spend, terminal outcomes, and anomalies. Replay semantics: budget_reserved sets reserved; cost_recorded adds spend and consumes reservation; reservation_released zeroes; reconciliation_completed sets absolutely (terminal only when marked); terminal events are first-wins; unknown event types ignored. reserved_msat omits zero-value keys.",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "reserved_msat",
    "spent_msat",
    "total_spent_msat",
    "terminal",
    "anomalies"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_name": {
      "const": "ledger_projection"
    },
    "schema_version": {
      "const": 0
    },
    "reserved_msat": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "spent_msat": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "total_spent_msat": {
      "type": "integer",
      "minimum": 0
    },
    "terminal": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "intent_rejected",
          "intent_deferred",
          "execution_succeeded",
          "execution_failed",
          "execution_outcome_unknown",
          "reconciliation_completed"
        ]
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "examples": [
    {
      "schema_name": "ledger_projection",
      "schema_version": 0,
      "reserved_msat": {
        "k1": 400000
      },
      "spent_msat": {
        "k2": 7000
      },
      "total_spent_msat": 7000,
      "terminal": {
        "k2": "execution_succeeded"
      },
      "anomalies": []
    }
  ]
}

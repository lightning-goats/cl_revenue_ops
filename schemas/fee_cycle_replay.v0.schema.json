    "payload_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_name": {
      "const": "fee_cycle_replay"
    },
    "schema_version": {
      "const": 0
    },
    "capture_run_id": {
      "type": "string",
      "minLength": 1
    },
    "capture_seq": {
      "type": "integer",
      "minimum": 1
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "$ref": "#/$defs/wire_object"
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "configuration": {
      "$ref": "#/$defs/wire_object"
    },
    "pre_state": {
      "$ref": "#/$defs/wire_object"
    },
    "observations": {
      "$ref": "#/$defs/wire_object"
    },
    "expected": {
      "$ref": "#/$defs/wire_object"
    },
    "completeness": {
      "type": "object",
      "required": [
        "complete"
      ],
      "properties": {
        "complete": {
          "const": true
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/wire_value"
      }
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "tagged_float": {
      "type": "object",
      "required": [
        "__f__"
      ],
      "additionalProperties": false,
      "properties": {
        "__f__": {
          "type": "string"
        }
      }
    },
    "wire_object": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/wire_value"
      }
    },
    "wire_value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wire_value"
          }
        },
        {
          "type": "object",
          "if": {
            "required": [
              "__f__"
            ]
          },
          "then": {
            "$ref": "#/$defs/tagged_float"
          },
          "else": {
            "additionalProperties": {
              "$ref": "#/$defs/wire_value"
            }
          }
        }
      ]
    }
  },

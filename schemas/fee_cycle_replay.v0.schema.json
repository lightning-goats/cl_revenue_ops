{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cl-revenue-ops.invalid/fee_cycle_replay.v0.schema.json",
  "title": "Fee Cycle Replay v0",
  "type": "object",
  "required": [

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# Test / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
coverage.xml

# Editors / OS
.vscode/
.idea/
.DS_Store

# Local env files
.env
.env.*

# SQLite database + WAL artifacts (default db_path: ~/.lightning/revenue_ops.db)
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# Logs
*.log

# Generated experiment outputs
#
# Keep curated summaries in docs/ or as intentional top-level results/*.md files.
# Timestamped run directories should stay local unless force-added on purpose.
results/fee-*/
results/hive-hints-truth-*/
results/module-loop-*/
results/rebalancer-polar-mcp-*/
artifacts/

# unittest.mock spillover from accidental file-backed mocks
MagicMock/

# Local runtime/state directories (if created)
logs/
data/

# Vendor directory (bundled dependencies)
vendor/

# Local git worktrees
.worktrees/


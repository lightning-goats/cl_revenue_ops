# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# Test / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
coverage.xml

# Editors / OS
.vscode/
.idea/
.DS_Store

# Local env files
.env
.env.*

# SQLite database + WAL artifacts (default db_path: ~/.lightning/revenue_ops.db)
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# Logs
*.log

# Publication boundary: local-only development artifacts.
#
# Keep raw run captures, internal implementation plans, reviewer bundles, and
# scratch analysis local. Publish operator docs, compatibility docs, and tests
# that protect production behavior.
results/
docs/plans/
docs/superpowers/
docs/local/
docs/internal/
artifacts/
*.zip

# unittest.mock spillover from accidental file-backed mocks
MagicMock/

# Local runtime/state directories (if created)
logs/
data/
results/revenue-validation/

# Vendor directory (bundled dependencies)
vendor/

# Local git worktrees
.worktrees/

# Generated validation drafts
docs/reports/*-production-t14-findings.md
docs/reports/*-production-t28-findings.md


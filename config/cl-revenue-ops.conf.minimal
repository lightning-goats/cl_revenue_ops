# cl-revenue-ops Production Config
# Copy to ~/.lightning/config or include via: include /path/to/cl-revenue-ops.conf

# Core settings
revenue-ops-dry-run=false

# Fee management (competitive but profitable)
revenue-ops-min-fee-ppm=100
revenue-ops-max-fee-ppm=2500
revenue-ops-fee-interval=3600
# Use "conservative" if this node has sparse routing traffic.
revenue-ops-fee-profile=active
# NOTE: the fee-market-boundary feature is DEPRECATED (providers are
# hard-disabled after a production incident); its options are inert and
# kept only for config back-compat. Competitive pricing is handled by the
# neighbor-median undercut/match/premium market modes instead.

# Fee defense
revenue-ops-vegas-reflex=true

# Rebalancing
revenue-ops-rebalance-min-profit=50
revenue-ops-daily-budget-sats=5000
revenue-ops-weekly-budget-sats=25000
# Rebalances execute the exact route priced by askrene.

# Risk management
revenue-ops-enable-kelly=true
revenue-ops-enable-reputation=true

# Hot-channel protection
revenue-ops-hot-channel-protection-enabled=true

# Capacity planner
# Once enabled, planner closes are recommendation-only by default.
# Set revenue-ops-planner-execute-closes=true and planner-max-closes-per-cycle>0 only if you want live close RPCs.
#revenue-ops-planner-enabled=true
#revenue-ops-planner-execute-closes=false
#revenue-ops-planner-max-opens-per-cycle=1
#revenue-ops-planner-max-closes-per-cycle=0
#revenue-ops-planner-min-annual-roi-pct=1.0

# LN+ liquidity swap automation (lightningnetwork.plus)
# Autonomous by default. One swap in flight at a time; circuit breaker trips on any
# missed obligation and blocks new applications until revenue-lnplus-breaker-clear.
#revenue-ops-lnplus-swaps-enabled=true
#revenue-ops-lnplus-execute-applications=true
#revenue-ops-lnplus-swap-preference-margin=0.2
#revenue-ops-lnplus-max-duration-months=3
#revenue-ops-lnplus-min-peer-rank=8
#revenue-ops-lnplus-min-participants=3
#revenue-ops-lnplus-fleet-pubkeys=<pubkey1>,<pubkey2>
